/* =========================================================
   AQUA REMIND — DESKTOP-OPTIMIZED THEME & DESIGN SYSTEM
   ========================================================= */
:root {
    --bg-desktop: linear-gradient(135deg, #e0f7fa 0%, #e0f2fe 48%, #f0f9ff 100%);
    --aqua-main: #0ea5e9;
    --aqua-deep: #0284c7;
    --sky-soft: #7dd3fc;
    --baby-blue: #bae6fd;
    --cyan-soft: #cffafe;

    --surface-glass: rgba(255, 255, 255, 0.78);
    --surface-card: rgba(255, 255, 255, 0.92);
    --border-glass: rgba(255, 255, 255, 0.72);

    --ink-navy: #0c2340;
    --ink-slate: #466382;

    --island-bg: #081c34;
    --island-border: rgba(125, 211, 252, 0.28);
    --island-ink: #f0f9ff;

    /* Deadline & Status Palette */
    --c-red: #ef4444;
    --c-red-soft: rgba(239, 68, 68, 0.13);
    --c-yellow: #f59e0b;
    --c-yellow-soft: rgba(245, 158, 11, 0.15);
    --c-green: #10b981;
    --c-green-soft: rgba(16, 185, 129, 0.14);
    --c-blue: #0284c7;
    --c-blue-soft: rgba(2, 132, 199, 0.11);

    --shadow-panel: 0 12px 32px -6px rgba(14, 165, 233, 0.14);
    --shadow-island: 0 18px 40px rgba(8, 28, 52, 0.34);

    --r-xl: 24px;
    --r-lg: 18px;
    --r-md: 12px;
    --ease-smooth: cubic-bezier(0.22, 1, 0.36, 1);
}

[data-theme="dark"] {
    --bg-desktop: linear-gradient(135deg, #051120 0%, #091e36 52%, #0d2a4a 100%);
    --aqua-main: #38bdf8;
    --aqua-deep: #0ea5e9;
    --sky-soft: #38bdf8;
    --baby-blue: #16365c;
    --cyan-soft: #123e54;

    --surface-glass: rgba(12, 34, 60, 0.76);
    --surface-card: rgba(14, 40, 70, 0.94);
    --border-glass: rgba(56, 189, 248, 0.2);

    --ink-navy: #e0f2fe;
    --ink-slate: #93b7d8;

    --island-bg: #04101e;
    --shadow-panel: 0 14px 36px rgba(0, 0, 0, 0.42);
}

/* =========================================================
   BASE & RESET
   ========================================================= */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg-desktop);
    background-attachment: fixed;
    color: var(--ink-navy);
    min-height: 100vh;
    min-width: 1024px; /* Dirancang khusus layar desktop / laptop */
    padding-top: 76px;
    transition: background 0.35s ease, color 0.25s ease;
    overflow-x: auto;
}

.mono {
    font-family: 'JetBrains Mono', monospace;
}

.hidden {
    display: none !important;
}

/* Ambient Orbs */
.ambient-orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(85px);
    pointer-events: none;
    z-index: -1;
    opacity: 0.5;
}
.orb-top-left { width: 420px; height: 420px; background: #7dd3fc; top: -120px; left: 160px; }
.orb-bottom-right { width: 460px; height: 460px; background: #a5f3fc; bottom: -140px; right: -80px; }
.orb-center { width: 320px; height: 320px; background: #bae6fd; top: 38%; left: 52%; }

.glass-panel {
    background: var(--surface-glass);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--border-glass);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-panel);
}

/* =========================================================
   DESKTOP DYNAMIC ISLAND (TOP CENTER)
   ========================================================= */
.di-anchor {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 1200;
    display: flex;
    justify-content: center;
    pointer-events: none;
}

.dynamic-island {
    pointer-events: auto;
    background: var(--island-bg);
    color: var(--island-ink);
    border: 1px solid var(--island-border);
    border-radius: 999px;
    width: 640px;
    padding: 10px 22px;
    box-shadow: var(--shadow-island);
    cursor: pointer;
    overflow: hidden;
    transition: width 0.42s var(--ease-smooth),
                border-radius 0.42s var(--ease-smooth),
                padding 0.42s var(--ease-smooth),
                transform 0.25s var(--ease-smooth),
                box-shadow 0.25s ease;
}

.dynamic-island:hover {
    transform: translateY(2px);
    box-shadow: 0 22px 46px rgba(8, 28, 52, 0.44);
}

.dynamic-island.expanded {
    width: 780px;
    border-radius: 28px;
    padding: 18px 24px;
    cursor: default;
}

.di-compact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
}

.di-seg {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.di-divider {
    width: 1px;
    height: 14px;
    background: rgba(148, 163, 184, 0.28);
}

.di-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
    animation: pulseGlow 2s infinite;
}
.di-dot.alert {
    background: #f87171;
    box-shadow: 0 0 10px #ef4444;
}

@keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.82); }
}

.di-prayer-seg { color: #7dd3fc; }
.di-timer-seg {
    background: rgba(56, 189, 248, 0.16);
    color: #bae6fd;
    padding: 3px 10px;
    border-radius: 999px;
}
.di-task-seg {
    max-width: 185px;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #e2e8f0;
}

.di-expanded {
    display: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    animation: fadeUp 0.28s ease;
}

.dynamic-island.expanded .di-expanded {
    display: block;
}

.di-exp-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: #93c5fd;
    margin-bottom: 12px;
}

.di-brand-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
}

.di-exp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.di-panel {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(125, 211, 252, 0.14);
    border-radius: 16px;
    padding: 12px 14px;
}

.di-panel-label {
    font-size: 0.72rem;
    color: #94a3b8;
    display: block;
    margin-bottom: 4px;
}

.di-panel-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.di-panel-mono {
    font-size: 1.15rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 4px;
}

.di-panel-sub {
    font-size: 0.78rem;
    color: #bae6fd;
    margin-top: 4px;
}

/* =========================================================
   DESKTOP LAYOUT: LEFT SIDEBAR + CENTER/MAIN WORKSPACE
   ========================================================= */
.desktop-shell {
    max-width: 1440px;
    margin: 0 auto;
    padding: 14px 28px 44px;
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 28px;
    align-items: start;
}

/* Left Sidebar */
.desktop-sidebar {
    position: sticky;
    top: 90px;
    height: calc(100vh - 112px);
    background: var(--surface-glass);
    backdrop-filter: blur(18px);
    border: 1px solid var(--border-glass);
    border-radius: var(--r-xl);
    padding: 24px 18px;
    box-shadow: var(--shadow-panel);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.sidebar-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 8px 20px;
    border-bottom: 1px solid rgba(14, 165, 233, 0.15);
}

.logo-badge {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: linear-gradient(135deg, #0ea5e9, #0369a1);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 1.45rem;
    box-shadow: 0 8px 18px rgba(14, 165, 233, 0.32);
}

.app-title {
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: 0.02em;
}

.app-edition {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-slate);
}

.sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 20px;
    flex: 1;
}

.menu-item {
    width: 100%;
    border: none;
    background: transparent;
    color: var(--ink-slate);
    font-family: inherit;
    font-size: 0.94rem;
    font-weight: 600;
    padding: 12px 14px;
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.22s var(--ease-smooth);
}

.menu-item i {
    font-size: 1.25rem;
}

.menu-item:hover {
    background: rgba(14, 165, 233, 0.13);
    color: var(--aqua-main);
    transform: translateX(4px);
}

.menu-item.active {
    background: linear-gradient(135deg, #0ea5e9, #0284c7);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(14, 165, 233, 0.32);
}

.menu-badge {
    margin-left: auto;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--baby-blue);
    color: var(--ink-navy);
}

.menu-item.active .menu-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
}

.sidebar-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgba(14, 165, 233, 0.15);
}

.sidebar-status-box {
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    border-radius: var(--r-md);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.78rem;
}

.status-row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
}

.status-row span { color: var(--ink-slate); }
.status-row strong { color: var(--ink-navy); text-align: right; }

.btn-install-desktop {
    width: 100%;
    border: none;
    border-radius: var(--r-md);
    padding: 11px 14px;
    background: var(--ink-navy);
    color: #ffffff;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.btn-install-desktop:hover {
    transform: translateY(-2px);
    opacity: 0.95;
}

/* Main Workspace */
.desktop-main {
    min-width: 0;
}

.workspace-section {
    display: none;
    animation: fadeUp 0.3s var(--ease-smooth);
}

.workspace-section.active {
    display: block;
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

.section-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
}

.section-topbar h2 {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
}

.section-topbar p {
    color: var(--ink-slate);
    font-size: 0.92rem;
    margin-top: 3px;
}

/* =========================================================
   BUTTONS & FORM CONTROLS
   ========================================================= */
.btn-aqua, .btn-outline, .btn-amber, .btn-danger-outline, .btn-ghost {
    font-family: inherit;
    font-weight: 600;
    border-radius: var(--r-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.22s var(--ease-smooth);
}

.btn-aqua {
    border: none;
    padding: 11px 20px;
    font-size: 0.9rem;
    color: #ffffff;
    background: linear-gradient(135deg, #0ea5e9, #0284c7);
    box-shadow: 0 8px 18px rgba(14, 165, 233, 0.28);
}

.btn-aqua:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(14, 165, 233, 0.38);
}

.btn-outline {
    border: 1px solid var(--border-glass);
    padding: 10px 16px;
    font-size: 0.88rem;
    background: var(--surface-card);
    color: var(--ink-navy);
}

.btn-outline:hover {
    background: var(--baby-blue);
    color: #0c2340;
}

.btn-amber {
    border: none;
    padding: 11px 20px;
    background: #f59e0b;
    color: #ffffff;
}

.btn-danger-outline {
    border: 1px solid rgba(239, 68, 68, 0.45);
    padding: 10px 16px;
    font-size: 0.88rem;
    background: rgba(239, 68, 68, 0.08);
    color: #dc2626;
}

.btn-danger-outline:hover {
    background: #ef4444;
    color: #ffffff;
}

.btn-ghost {
    border: none;
    background: transparent;
    color: var(--aqua-deep);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 4px 8px;
}
.btn-ghost:hover { text-decoration: underline; }

.btn-sm { padding: 7px 13px; font-size: 0.82rem; }
.btn-lg { padding: 13px 26px; font-size: 0.98rem; border-radius: 14px; }

.input-desktop, .select-desktop {
    width: 100%;
    padding: 11px 14px;
    border-radius: var(--r-md);
    border: 1px solid var(--border-glass);
    background: var(--surface-card);
    color: var(--ink-navy);
    font-family: inherit;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.input-desktop:focus, .select-desktop:focus {
    border-color: var(--aqua-main);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.18);
}

.input-short { width: 110px; }

/* =========================================================
   DASHBOARD & INTERACTIVE MASCOT AVATAR
   ========================================================= */
.dashboard-hero {
    padding: 28px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    margin-bottom: 22px;
}

.hero-main { flex: 1; }

.hero-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}

.date-chip {
    background: var(--cyan-soft);
    color: #0369a1;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
}

.loc-chip {
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    color: var(--ink-slate);
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.hero-main h1 {
    font-size: 2.05rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 8px;
}

.hero-desc {
    color: var(--ink-slate);
    font-size: 0.95rem;
    max-width: 620px;
    margin-bottom: 18px;
}

.hero-clock-strip {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    padding: 12px 22px;
    border-radius: var(--r-lg);
}

.clock-block { display: flex; flex-direction: column; }
.clock-label { font-size: 0.72rem; font-weight: 700; color: var(--ink-slate); text-transform: uppercase; }
.clock-digits { font-size: 1.65rem; font-weight: 700; color: var(--aqua-deep); }
.clock-prayer { font-size: 1.05rem; font-weight: 700; color: var(--ink-navy); margin-top: 3px; }
.clock-sep { width: 1px; height: 34px; background: rgba(14, 165, 233, 0.2); }

/* Mascot Corner Avatar */
.mascot-corner {
    width: 215px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    user-select: none;
}

.mascot-bubble {
    background: var(--surface-card);
    border: 1px solid var(--sky-soft);
    border-radius: 16px;
    padding: 9px 14px;
    font-size: 0.78rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 10px;
    box-shadow: 0 8px 18px rgba(14, 165, 233, 0.14);
    transition: transform 0.25s var(--ease-smooth);
}

.mascot-corner:hover .mascot-bubble {
    transform: translateY(-2px);
}

.mascot-frame {
    width: 136px;
    height: 136px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #ffffff, #bae6fd);
    border: 3px solid #ffffff;
    box-shadow: 0 12px 26px rgba(14, 165, 233, 0.28);
    display: grid;
    place-items: center;
    overflow: hidden;
}

.mascot-svg-anim {
    width: 120px;
    height: 120px;
    animation: gentleFloat 3.4s ease-in-out infinite;
}

.mascot-svg-anim.bounce-mood {
    animation: happyHop 0.65s ease infinite;
}

@keyframes gentleFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(1.5deg); }
}

@keyframes happyHop {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.04); }
}

.eyelid-anim {
    transform-origin: center;
    animation: eyeBlink 4.6s infinite;
}

@keyframes eyeBlink {
    0%, 93%, 100% { transform: scaleY(0); }
    96% { transform: scaleY(1); }
}

.mascot-caption {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 700;
}

.mascot-mood-pill {
    background: rgba(14, 165, 233, 0.15);
    color: var(--aqua-deep);
    padding: 2px 9px;
    border-radius: 999px;
}

/* KPI Row */
.kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 22px;
}

.kpi-card {
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
}

.kpi-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.kpi-amber { background: var(--c-yellow-soft); color: #d97706; }
.kpi-emerald { background: var(--c-green-soft); color: #059669; }
.kpi-aqua { background: var(--c-blue-soft); color: var(--aqua-deep); }
.kpi-navy { background: rgba(12, 35, 64, 0.12); color: var(--ink-navy); }

.kpi-title { font-size: 0.78rem; font-weight: 600; color: var(--ink-slate); }
.kpi-num { font-size: 1.6rem; font-weight: 800; line-height: 1.2; }

.kpi-progress-wrap { flex: 1; }
.kpi-progress-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.progress-track {
    width: 100%;
    height: 8px;
    border-radius: 999px;
    background: rgba(14, 165, 233, 0.16);
    overflow: hidden;
}
.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #38bdf8, #0284c7);
    border-radius: 999px;
    transition: width 0.45s ease;
}

/* Dashboard Split Grid */
.dashboard-split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 20px;
}

.panel-box { padding: 22px; }
.dashboard-side-stack { display: flex; flex-direction: column; gap: 20px; }

.panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.panel-head h3 {
    font-size: 1.04rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
}

.dash-task-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.dash-task-item {
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    border-left: 4px solid var(--c-blue);
    border-radius: var(--r-md);
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}

.dash-task-item.near { border-left-color: var(--c-yellow); }
.dash-task-item.overdue { border-left-color: var(--c-red); }

.dash-prayer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
}

.dash-prayer-cell {
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    border-radius: 12px;
    padding: 10px 6px;
    text-align: center;
}

.dash-prayer-cell.is-next {
    background: var(--cyan-soft);
    border-color: var(--aqua-main);
    color: #0c2340;
}

.dash-prayer-cell span { display: block; font-size: 0.74rem; font-weight: 600; color: var(--ink-slate); }
.dash-prayer-cell strong { font-size: 0.9rem; font-weight: 700; }

.quick-focus-bar {
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    border-radius: var(--r-md);
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.quick-timer-digits { font-size: 1.65rem; font-weight: 700; color: var(--aqua-deep); }
.quick-focus-actions { display: flex; gap: 8px; }

/* =========================================================
   TASKS SECTION
   ========================================================= */
.toolbar-card {
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
}

.filter-group { display: flex; gap: 8px; flex-wrap: wrap; }

.chip-btn {
    border: 1px solid var(--border-glass);
    background: var(--surface-card);
    color: var(--ink-slate);
    padding: 7px 14px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.chip-btn.active {
    background: var(--aqua-main);
    color: #ffffff;
    border-color: var(--aqua-main);
}

.search-input-wrap {
    position: relative;
    width: 290px;
}

.search-input-wrap i {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-slate);
}

.search-input-wrap input {
    width: 100%;
    padding: 8px 14px 8px 36px;
    border-radius: 999px;
    border: 1px solid var(--border-glass);
    background: var(--surface-card);
    color: var(--ink-navy);
    font-family: inherit;
    font-size: 0.85rem;
    outline: none;
}

.legend-strip {
    display: flex;
    gap: 20px;
    font-size: 0.8rem;
    color: var(--ink-slate);
    margin-bottom: 18px;
}

.indicator {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 6px;
}
.ind-red { background: var(--c-red); }
.ind-yellow { background: var(--c-yellow); }
.ind-blue { background: var(--c-blue); }
.ind-green { background: var(--c-green); }

.tasks-desktop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.task-card-desktop {
    background: var(--surface-glass);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    border-left: 6px solid var(--c-blue);
    border-radius: var(--r-lg);
    padding: 18px 20px;
    box-shadow: var(--shadow-panel);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    transition: transform 0.22s var(--ease-smooth);
}

.task-card-desktop:hover { transform: translateY(-3px); }

.task-card-desktop.st-overdue {
    border-left-color: var(--c-red);
    background: linear-gradient(to right, var(--c-red-soft), var(--surface-glass));
}
.task-card-desktop.st-near {
    border-left-color: var(--c-yellow);
    background: linear-gradient(to right, var(--c-yellow-soft), var(--surface-glass));
}
.task-card-desktop.st-completed {
    border-left-color: var(--c-green);
    background: linear-gradient(to right, var(--c-green-soft), var(--surface-glass));
    opacity: 0.9;
}

.task-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}

.mapel-pill {
    background: var(--cyan-soft);
    color: #0369a1;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
}

.prio-pill {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
}
.prio-Tinggi { background: rgba(239, 68, 68, 0.16); color: #dc2626; }
.prio-Sedang { background: rgba(245, 158, 11, 0.18); color: #d97706; }
.prio-Rendah { background: rgba(14, 165, 233, 0.16); color: #0284c7; }

.task-card-title {
    font-size: 1.04rem;
    font-weight: 700;
    margin-top: 8px;
}
.task-card-desktop.st-completed .task-card-title {
    text-decoration: line-through;
    color: var(--ink-slate);
}

.task-card-notes {
    font-size: 0.84rem;
    color: var(--ink-slate);
    margin-top: 4px;
    line-height: 1.45;
}

.task-card-meta {
    font-size: 0.8rem;
    color: var(--ink-slate);
    padding-top: 10px;
    border-top: 1px dashed rgba(14, 165, 233, 0.25);
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.st-overdue .deadline-status-txt { color: var(--c-red); font-weight: 700; }
.st-near .deadline-status-txt { color: #d97706; font-weight: 700; }
.st-completed .deadline-status-txt { color: #059669; font-weight: 700; }

.task-card-foot {
    display: flex;
    align-items: center;
    gap: 8px;
}

.btn-done-toggle {
    flex: 1;
    border: 1px solid var(--aqua-main);
    background: transparent;
    color: var(--aqua-deep);
    padding: 8px 12px;
    border-radius: 10px;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.2s ease;
}

.btn-done-toggle:hover, .task-card-desktop.st-completed .btn-done-toggle {
    background: var(--c-green);
    border-color: var(--c-green);
    color: #ffffff;
}

.icon-action-btn {
    border: none;
    background: transparent;
    color: var(--ink-slate);
    font-size: 1.15rem;
    padding: 6px;
    border-radius: 8px;
    cursor: pointer;
}
.icon-action-btn:hover { background: rgba(14, 165, 233, 0.14); color: var(--ink-navy); }

/* =========================================================
   PRAYER SCHEDULE SECTION
   ========================================================= */
.prayer-controls-row {
    display: flex;
    align-items: center;
    gap: 10px;
}
.prayer-controls-row .select-desktop { width: 250px; }

.prayer-hero-banner {
    padding: 26px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 22px;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.92), rgba(3, 105, 161, 0.95));
    color: #ffffff;
}

.prayer-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
}

.prayer-hero-banner h3 { font-size: 2rem; font-weight: 800; margin-top: 8px; }
.prayer-hijri { opacity: 0.9; font-size: 0.9rem; margin-top: 4px; }

.prayer-countdown-box { text-align: right; }
.countdown-caption { font-size: 0.8rem; opacity: 0.9; display: block; }
.countdown-big { font-size: 2.35rem; font-weight: 700; letter-spacing: 1px; margin: 2px 0; }

.prayer-five-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
}

.prayer-slot-card {
    padding: 24px 18px;
    text-align: center;
    transition: transform 0.22s ease;
}

.prayer-slot-card:hover { transform: translateY(-4px); }

.prayer-slot-card.next-slot {
    border: 2px solid var(--aqua-main);
    background: var(--surface-card);
}

.prayer-slot-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--cyan-soft);
    color: #0284c7;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    margin: 0 auto 14px;
}

.prayer-slot-card h4 { font-size: 1.08rem; font-weight: 700; margin-bottom: 6px; }
.prayer-slot-time { font-size: 1.65rem; font-weight: 700; color: var(--aqua-deep); }
.next-slot-badge {
    display: inline-block;
    margin-top: 10px;
    background: var(--aqua-main);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 11px;
    border-radius: 999px;
}

/* =========================================================
   FOCUS / POMODORO / STOPWATCH SECTION
   ========================================================= */
.session-pill {
    padding: 10px 18px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
}
.session-pill i { color: #f97316; font-size: 1.2rem; }

.focus-stage {
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
}

.mode-selector-bar {
    display: flex;
    gap: 8px;
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    padding: 6px;
    border-radius: 999px;
}

.mode-pill {
    border: none;
    background: transparent;
    color: var(--ink-slate);
    padding: 9px 18px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.mode-pill.active {
    background: var(--aqua-main);
    color: #ffffff;
}

.custom-duration-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    font-weight: 600;
}

.timer-visual-box {
    position: relative;
    width: 280px;
    height: 280px;
    display: grid;
    place-items: center;
}

.progress-ring-svg { transform: rotate(-90deg); }
.ring-track { fill: none; stroke: rgba(14, 165, 233, 0.16); stroke-width: 12; }
.ring-indicator {
    fill: none;
    stroke: var(--aqua-main);
    stroke-width: 12;
    stroke-linecap: round;
    stroke-dasharray: 766.55;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.35s linear;
}

.timer-readout-center {
    position: absolute;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.focus-mode-badge {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--aqua-deep);
}

.focus-big-digits {
    font-size: 3.3rem;
    font-weight: 700;
    margin: 4px 0;
}

.focus-state-text { font-size: 0.85rem; color: var(--ink-slate); }

.focus-buttons-row { display: flex; gap: 14px; }

/* =========================================================
   SETTINGS SECTION
   ========================================================= */
.settings-two-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
}

.settings-box {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.settings-box h3 {
    font-size: 1.08rem;
    font-weight: 700;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(14, 165, 233, 0.16);
    display: flex;
    align-items: center;
    gap: 8px;
}

.field-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}
.field-group label { font-size: 0.86rem; font-weight: 600; }

.mascot-picker-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.mascot-opt {
    border: 1px solid var(--border-glass);
    background: var(--surface-card);
    color: var(--ink-navy);
    padding: 12px 14px;
    border-radius: var(--r-md);
    font-family: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
}

.mascot-opt span { font-size: 1.35rem; }
.mascot-opt.active {
    border: 2px solid var(--aqua-main);
    background: var(--cyan-soft);
    color: #0c2340;
}

.theme-choice-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.theme-opt {
    border: 1px solid var(--border-glass);
    background: var(--surface-card);
    color: var(--ink-navy);
    padding: 11px 14px;
    border-radius: var(--r-md);
    font-family: inherit;
    font-weight: 600;
    font-size: 0.86rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.theme-opt.active {
    background: var(--aqua-main);
    color: #ffffff;
    border-color: var(--aqua-main);
}

.permission-banner {
    background: var(--surface-card);
    border: 1px solid var(--border-glass);
    border-radius: var(--r-md);
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}
.permission-banner p { font-size: 0.8rem; color: var(--ink-slate); margin-top: 2px; }

.switch-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}
.switch-item small { display: block; color: var(--ink-slate); font-size: 0.78rem; margin-top: 2px; }

.toggle-switch {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 26px;
    flex-shrink: 0;
}
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-slider {
    position: absolute;
    inset: 0;
    background: #cbd5e1;
    border-radius: 999px;
    cursor: pointer;
    transition: 0.25s;
}
.toggle-slider::before {
    content: "";
    position: absolute;
    width: 20px;
    height: 20px;
    left: 3px;
    bottom: 3px;
    background: #ffffff;
    border-radius: 50%;
    transition: 0.25s;
}
input:checked + .toggle-slider { background: var(--aqua-main); }
input:checked + .toggle-slider::before { transform: translateX(22px); }

.settings-btn-group {
    display: flex;
    gap: 12px;
    padding-top: 6px;
}

/* =========================================================
   FLOATING REMINDER WIDGET (BOTTOM RIGHT DESKTOP)
   ========================================================= */
.floating-reminder {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 290px;
    z-index: 1050;
    background: var(--surface-card);
    backdrop-filter: blur(18px);
    border: 1px solid var(--sky-soft);
    border-radius: var(--r-lg);
    padding: 14px 16px;
    box-shadow: var(--shadow-panel);
    transition: all 0.25s var(--ease-smooth);
}

.floating-reminder.minimized .fr-body {
    display: none;
}

.fr-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.floating-reminder.minimized .fr-header {
    margin-bottom: 0;
}

.fr-badge {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--aqua-deep);
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.fr-icon-btn {
    border: none;
    background: rgba(14, 165, 233, 0.12);
    color: var(--ink-navy);
    width: 24px;
    height: 24px;
    border-radius: 8px;
    cursor: pointer;
    display: grid;
    place-items: center;
}

.fr-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.fr-item {
    background: var(--surface-glass);
    border-radius: 10px;
    padding: 8px 10px;
}

.fr-item small {
    display: block;
    font-size: 0.7rem;
    color: var(--ink-slate);
}

.fr-item strong {
    font-size: 0.84rem;
    color: var(--ink-navy);
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* =========================================================
   MODAL & TOAST ALERTS
   ========================================================= */
.modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1500;
    background: rgba(5, 17, 32, 0.56);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.modal-dialog {
    width: 540px;
    background: var(--surface-card);
    padding: 26px;
}

.modal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.icon-close-btn {
    border: none;
    background: transparent;
    font-size: 1.4rem;
    color: var(--ink-slate);
    cursor: pointer;
    border-radius: 8px;
    padding: 4px;
}
.icon-close-btn:hover { background: rgba(14, 165, 233, 0.14); color: var(--ink-navy); }

.modal-form { display: flex; flex-direction: column; gap: 14px; }
.two-col-form { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; }

.toast-stack {
    position: fixed;
    left: 298px;
    bottom: 24px;
    z-index: 1600;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 420px;
}

.toast-card {
    background: var(--island-bg);
    color: #ffffff;
    border: 1px solid var(--island-border);
    border-left: 4px solid #38bdf8;
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 0.85rem;
    box-shadow: var(--shadow-island);
    display: flex;
    align-items: center;
    gap: 10px;
    animation: fadeUp 0.25s ease;
}
